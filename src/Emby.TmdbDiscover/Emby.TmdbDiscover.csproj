<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Emby.TmdbDiscover</AssemblyName>
    <RootNamespace>Emby.TmdbDiscover</RootNamespace>
    <LangVersion>8.0</LangVersion>

    <!-- Emby reads the assembly version to show the installed version and to
         decide whether a catalog release is an update, so this must be real and
         must be bumped on every release. It also keys the configuration page's
         cache-busting slug (see DiscoverConfigPage.Name). -->
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>Discover for Emby</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\not-in-library.mp4" Condition="Exists('Resources\not-in-library.mp4')" />
    <EmbeddedResource Include="Channels\Images\channel-icon.png" />
  </ItemGroup>

</Project>
